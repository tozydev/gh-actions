{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>tozydev/tozydev"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/**",
        "!.github/workflows/shared*"
      ],
      "groupName": "repo actions",
      "semanticCommitType": "chore"
    }
  ]
}
